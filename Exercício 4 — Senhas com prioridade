import java.util.LinkedList;
import java.util.Queue;
import java.util.Scanner;

class Pessoa {
    String nome;
    String tipoSenha;

    Pessoa(String nome, String tipoSenha) {
        this.nome = nome;
        this.tipoSenha = tipoSenha;
    }

    public String toString() {
        return nome + " (" + tipoSenha + ")";
    }
}

public class SistemaAtendimento {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Queue<Pessoa> filaNormal = new LinkedList<>();
        Queue<Pessoa> filaPrioritaria = new LinkedList<>();

        System.out.print("Quantas pessoas serão cadastradas? ");
        int n = sc.nextInt();
        sc.nextLine();

        for (int i = 0; i < n; i++) {
            System.out.print("Nome: ");
            String nome = sc.nextLine();
            System.out.print("Tipo de senha (normal/prioritaria): ");
            String tipo = sc.nextLine().toLowerCase();
            Pessoa p = new Pessoa(nome, tipo);
            if (tipo.equals("prioritaria")) filaPrioritaria.add(p);
            else filaNormal.add(p);
        }

        System.out.println("\nOrdem de atendimento:");
        int contPrioritaria = 0;

        while (!filaNormal.isEmpty() || !filaPrioritaria.isEmpty()) {
            if (!filaPrioritaria.isEmpty() && (contPrioritaria < 3 || filaNormal.isEmpty())) {
                System.out.println(filaPrioritaria.poll());
                contPrioritaria++;
            } else if (!filaNormal.isEmpty()) {
                System.out.println(filaNormal.poll());
                contPrioritaria = 0;
            } else if (!filaPrioritaria.isEmpty()) {
                System.out.println(filaPrioritaria.poll());
                contPrioritaria++;
            }
        }

        sc.close();
    }
}
