import java.util.LinkedList;
import java.util.Queue;


class Chamada {
    private String nome;
    private String assunto;

    public Chamada(String nome, String assunto) {
        this.nome = nome;
        this.assunto = assunto;
    }

    public String getNome() {
        return nome;
    }

    public String getAssunto() {
        return assunto;
    }

    @Override
    public String toString() {
        return "Chamada de " + nome + " - Assunto: " + assunto;
    }
}


public class CentralTelefonica {
    private Queue<Chamada> filaChamadas;

    public CentralTelefonica() {
        filaChamadas = new LinkedList<>();
    }


    public void receberChamada(Chamada chamada) {
        filaChamadas.add(chamada);
        System.out.println("Nova chamada recebida: " + chamada);
    }

    public void atenderChamada() {
        if (filaChamadas.isEmpty()) {
            System.out.println("Não há chamadas para atender.");
        } else {
            Chamada chamadaAtual = filaChamadas.poll();
            System.out.println("Atendendo: " + chamadaAtual);
        }
    }

    public void mostrarProximaChamada() {
        if (filaChamadas.isEmpty()) {
            System.out.println("Nenhuma chamada aguardando.");
        } else {
            System.out.println("Próxima chamada: " + filaChamadas.peek());
        }
    }

    public void mostrarQuantidadeAguardando() {
        System.out.println("Chamadas aguardando: " + filaChamadas.size());
    }

    public static void main(String[] args) {
        CentralTelefonica central = new CentralTelefonica();

        central.receberChamada(new Chamada("Alice", "Suporte Técnico"));
        central.receberChamada(new Chamada("Bruno", "Financeiro"));
        central.receberChamada(new Chamada("Carla", "Agendamento"));

        System.out.println();
        central.mostrarProximaChamada();
        central.mostrarQuantidadeAguardando();

        System.out.println();
        central.atenderChamada();
        central.mostrarQuantidadeAguardando();

        System.out.println();
        central.atenderChamada();
        central.mostrarProximaChamada();
        central.mostrarQuantidadeAguardando();
    }
}
