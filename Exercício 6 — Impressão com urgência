import java.util.LinkedList;
import java.util.PriorityQueue;
import java.util.Queue;

class Documento implements Comparable<Documento> {
    private String nome;
    private int paginas;
    private int prioridade;
    private int ordemChegada;

    private static int contador = 0; // controla a ordem de chegada

    public Documento(String nome, int paginas, int prioridade) {
        this.nome = nome;
        this.paginas = paginas;
        this.prioridade = prioridade;
        this.ordemChegada = contador++;
    }

    public String getNome() {
        return nome;
    }

    public int getPaginas() {
        return paginas;
    }

    public int getPrioridade() {
        return prioridade;
    }


    @Override
    public int compareTo(Documento outro) {

        if (this.prioridade != outro.prioridade) {
            return outro.prioridade - this.prioridade;
        }

        return this.ordemChegada - outro.ordemChegada;
    }

    @Override
    public String toString() {
        return "Documento{" +
                "nome='" + nome + '\'' +
                ", paginas=" + paginas +
                ", prioridade=" + prioridade +
                '}';
    }
}

public class FilaImpressao {
    private PriorityQueue<Documento> fila;

    public FilaImpressao() {
        fila = new PriorityQueue<>();
    }


    public void adicionarDocumento(Documento doc) {
        fila.add(doc);
        System.out.println("Documento adicionado: " + doc);
    }


    public void imprimirTodos() {
        System.out.println("\n=== Iniciando impressão ===");
        while (!fila.isEmpty()) {
            Documento doc = fila.poll();
            System.out.println("Imprimindo: " + doc.getNome() + " (" + doc.getPaginas() + " páginas, prioridade " + doc.getPrioridade() + ")");
        }
        System.out.println("=== Impressão finalizada ===");
    }

    public static void main(String[] args) {
        FilaImpressao impressora = new FilaImpressao();


        impressora.adicionarDocumento(new Documento("Relatório Financeiro", 10, 2));
        impressora.adicionarDocumento(new Documento("Contrato Cliente", 5, 3));
        impressora.adicionarDocumento(new Documento("Resumo Semanal", 3, 2));
        impressora.adicionarDocumento(new Documento("Apresentação", 15, 1));

   
        impressora.imprimirTodos();
    }
}
