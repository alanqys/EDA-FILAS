import java.util.PriorityQueue;

class Documento {
    String nome;
    int paginas;
    int prioridade;
    int ordem;

    public Documento(String nome, int paginas, int prioridade, int ordem) {
        this.nome = nome;
        this.paginas = paginas;
        this.prioridade = prioridade;
        this.ordem = ordem;
    }
}

class FilaImpressao {
    private PriorityQueue<Documento> fila;
    private int contador;

    public FilaImpressao() {
        contador = 0;

        fila = new PriorityQueue<>((d1, d2) -> {
            if (d1.prioridade != d2.prioridade) {
                return d2.prioridade - d1.prioridade;
            }
            return d1.ordem - d2.ordem;
        });
    }

    public void adicionarDocumento(String nome, int paginas, int prioridade) {
        fila.add(new Documento(nome, paginas, prioridade, contador++));
    }

    public void imprimirProximo() {
        if (fila.isEmpty()) {
            System.out.println("Fila vazia.");
            return;
        }

        Documento doc = fila.poll();
        System.out.println("Imprimindo: " + doc.nome +
                " (" + doc.paginas + " páginas, prioridade " + doc.prioridade + ")");
    }
}

public class Main {
    public static void main(String[] args) {
        FilaImpressao fila = new FilaImpressao();

        fila.adicionarDocumento("Relatório", 10, 2);
        fila.adicionarDocumento("Contrato", 5, 3);
        fila.adicionarDocumento("Email", 2, 2);

        fila.imprimirProximo();
        fila.imprimirProximo();
        fila.imprimirProximo();
    }
}
