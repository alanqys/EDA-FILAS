import java.util.PriorityQueue;
import java.util.Scanner;

class Tarefa implements Comparable<Tarefa> {
    String nome;
    int prioridade;

    public Tarefa(String nome, int prioridade) {
        this.nome = nome;
        this.prioridade = prioridade;
    }

    @Override
    public int compareTo(Tarefa outra) {
        return Integer.compare(outra.prioridade, this.prioridade);
    }

    @Override
    public String toString() {
        return "Nome: " + nome + " | Prioridade: " + prioridade;
    }
}

public class AgendamentoDeTarefas {

    public static void main(String[] args) {
        PriorityQueue<Tarefa> fila = new PriorityQueue<>();
        Scanner scanner = new Scanner(System.in);

        int opcao;

        do {
            System.out.println("\n=== Fila de Tarefas do Sistema ===");
            System.out.println("1 - Adicionar tarefa");
            System.out.println("2 - Executar tarefa mais prioritária");
            System.out.println("3 - Mostrar fila");
            System.out.println("0 - Sair");
            System.out.print("Escolha: ");
            opcao = scanner.nextInt();
            scanner.nextLine();

            switch (opcao) {

                case 1:
                    System.out.print("Nome da tarefa: ");
                    String nome = scanner.nextLine();

                    System.out.print("Prioridade (maior número = mais importante): ");
                    int prioridade = scanner.nextInt();
                    scanner.nextLine();

                    fila.add(new Tarefa(nome, prioridade));

                    System.out.println("Tarefa adicionada!");
                    System.out.println("Total na fila: " + fila.size());
                    break;

                case 2:
                    if (!fila.isEmpty()) {

                        System.out.println("\n--- Fila ANTES da execução ---");
                        mostrarFila(fila);

                        Tarefa tarefa = fila.poll();

                        System.out.println("\n>>> Executando tarefa:");
                        System.out.println(tarefa);

                        System.out.println("\n--- Fila DEPOIS da execução ---");
                        mostrarFila(fila);

                    } else {
                        System.out.println("Fila vazia!");
                    }
                    break;

                case 3:
                    System.out.println("\n--- Fila atual ---");
                    mostrarFila(fila);
                    break;

                case 0:
                    System.out.println("Encerrando sistema...");
                    break;

                default:
                    System.out.println("Opção inválida!");
            }

        } while (opcao != 0);

        scanner.close();
    }

    public static void mostrarFila(PriorityQueue<Tarefa> fila) {
        if (fila.isEmpty()) {
            System.out.println("Fila vazia!");
            return;
        }

        PriorityQueue<Tarefa> copia = new PriorityQueue<>(fila);

        while (!copia.isEmpty()) {
            System.out.println(copia.poll());
        }
    }
}
